# ===== AI护心镜 后端环境变量示例 =====
# 复制为 backend/.env 并填写真实值；.env 不要提交到仓库

# JWT 密钥（生产环境请改成随机长字符串）
SECRET_KEY=please-change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 数据库连接串。默认 SQLite；生产可切 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ecg
DATABASE_URL=sqlite:///./storage/ecg_web.db

# CORS 允许来源（前端开发地址，多个用逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 智谱 GLM（仅 AI 功能使用，留空则 AI 接口返回未配置；不要写进代码）
ZHIPU_API_KEY=

# 前端生产产物目录与静态托管开关（npm run build:local 生成 frontend/dist）
# 默认指向项目根 frontend/dist；如产物在别处可改成绝对路径
# FRONTEND_DIST=
# SERVE_FRONTEND=true
